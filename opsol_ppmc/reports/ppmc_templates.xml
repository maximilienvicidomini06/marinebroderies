    <template id="report_ppmc_payment_document_page2">
        <t t-call="opsol_ppmc.external_layout_standard_page2">
        
            <t t-if="not company">
                <!-- Multicompany -->
                <t t-if="company_id">
                    <t t-set="company" t-value="company_id"/>
                </t>
                <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                    <t t-set="company" t-value="o.company_id.sudo()"/>
                </t>
                <t t-else="else">
                    <t t-set="company" t-value="res_company"/>
                </t>
            </t>
        
            <t t-set="payments" t-value="doc._get_payments()"/>
            <t t-set="header" t-value="doc._get_header_data()"/>
            <t t-set="total_amount" t-value="sum(payments.mapped('amount'))"/>
                
            <!--</div>-->
            <div class="page ppmc-report">

                <table class="table table-sm o_main_table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Tiers</th>
                            <th>Banque</th>
                            <th>Identifiant</th>
                            <th>N° facture</th>
                            <th>N° de compte</th>
                            <th>BIC</th>
                            <th class="text-end">Montant</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="payments" t-as="payment">
                            <tr>
                                <td><span t-esc="payment.date"/></td>
                                <td><span t-esc="payment.partner_id.display_name"/></td>
                                <td><span t-esc="payment.partner_id.bank_ids[:1].bank_id.name if payment.partner_id.bank_ids else ''"/></td>
                                <td>
                                    <span t-esc="payment.name"/>
                                </td>
                                <td>
                                    <span t-esc="payment.ref or ''"/>
                                </td>
                                <td>
                                    <span t-esc="payment.partner_bank_id.acc_number or ''"/>
                                </td>
                                <td>
                                    <span t-esc="payment.partner_bank_id.bank_id.bic or ''"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="payment.amount"/>
                                </td>
                            </tr>
                        </t>
                        <t t-if="not payments">
                            <tr>
                                <td colspan="8" class="text-center">Aucun paiement fournisseur.</td>
                            </tr>
                        </t>
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="7" class="text-end">Total</th>
                            <th class="text-end">
                                <span t-esc="total_amount"/>
                            </th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </t>
    </template>

