                <!--<div class="mb-2">-->
                <!--    <strong>Devise de remise:</strong>-->
                <!--    <span t-esc="header['currency'].name"/>-->
                <!--</div>-->

                <div class="row border mt-4 mb-2">
                    <div class="col-6">
                        <div><strong>Banque:</strong> <span t-esc="header['journal'].display_name if header['journal'] else ''"/></div>
                        <div><strong>RIB:</strong> <span t-esc="header['bank_account'].acc_number if header['bank_account'] else ''"/></div>
                    </div>
                    <div class="col-6">
                        <div><strong>Agence:</strong> </div>
                        <div><strong>Devise du RIB:</strong> <span t-esc="header['currency'].name if header['currency'] else ''"/></div>
                    </div>

                </div>

                <div class="row border mt-4 mb-2">
                    <div class="col-2">
                        <div><strong>Donneur d'ordre</strong> </div>
                    </div>
                    <div class="col-4 text-start text-left">
                        <div><strong><span t-esc="company.display_name if company else ''"/></strong></div>
                    </div>
                    <div class="col-6">
                        <div><strong>Identifiant</strong> <span t-esc="doc.name or ''"/></div>
