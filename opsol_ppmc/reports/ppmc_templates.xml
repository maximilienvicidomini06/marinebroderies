    <template id="report_ppmc_payment_document_page2">
        <t t-call="opsol_ppmc.external_layout_standard_page2">

            <t t-if="not company">
                <!-- Multicompany -->
                <t t-if="company_id">
                    <t t-set="company" t-value="company_id"/>
                </t>
                <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                    <t t-set="company" t-value="o.company_id.sudo()"/>
                </t>
                <t t-else="else">
                    <t t-set="company" t-value="res_company"/>
                </t>
            </t>

            <t t-set="payments" t-value="doc._get_payments()"/>
            <t t-set="header" t-value="doc._get_header_data()"/>
            <t t-set="total_amount" t-value="sum(payments.mapped('amount'))"/>

            <!--</div>-->
            <div class="page ppmc-report">
                <style>
                    .ppmc-report .o_main_table th,
                    .ppmc-report .o_main_table td {
                        padding: 6px 8px !important;
                    }
                </style>

                <table class="table table-sm o_main_table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Tiers</th>
                            <th>Banque</th>
                            <th>Identifiant</th>
                            <th>N° facture</th>
                            <th>N° de compte</th>
                            <th>BIC</th>
                            <th class="text-end">Montant</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="payments" t-as="payment">
                            <tr>
                                <td><span t-esc="payment.date"/></td>
                                <td><span t-esc="payment.partner_id.display_name"/></td>
                                <td><span t-esc="payment.partner_id.bank_ids[:1].bank_id.name if payment.partner_id.bank_ids else ''"/></td>
                                <td>
                                    <span t-esc="payment.name"/>
                                </td>
                                <td>
                                    <t t-set="invoice" t-value="(payment.reconciled_bill_ids | payment.reconciled_invoice_ids)[:1]"/>
                                    <t t-if="invoice">
                                        <a t-att-href="invoice.get_portal_url()">
                                            <span t-esc="payment.payment_reference or payment.memo or invoice.name"/>
                                        </a>
                                    </t>
                                    <t t-else="">
                                        <span t-esc="payment.payment_reference or payment.memo or ''"/>
                                    </t>
                                </td>
                                <td>
                                    <span t-esc="payment.partner_bank_id.acc_number or ''"/>
                                </td>
                                <td>
                                    <span t-esc="payment.partner_bank_id.bank_id.bic or ''"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="payment.amount"
                                          t-options="{'widget': 'monetary', 'display_currency': payment.currency_id}"/>
                                </td>
                            </tr>
                        </t>
                        <t t-if="not payments">
                            <tr>
                                <td colspan="8" class="text-center">Aucun paiement fournisseur.</td>
                            </tr>
                        </t>
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="7" class="text-end">Total</th>
                            <th class="text-end">
                                <span t-esc="total_amount"
                                      t-options="{'widget': 'monetary', 'display_currency': header['currency']}"/>
                            </th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </t>
    </template>

    <template id="report_ppmc_payment_document_page3">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <div class="page ppmc-page3" style="font-family: sans-serif; font-size: 12px; color: black; padding-top: -5rem;">

                        <div class="row">
                            <div class="col-6 offset-6 text-start">
                                <t t-set="company" t-value="o.company_id"/>
                                <div><strong/> <span t-esc="company.display_name"/></div>
                                <div t-if="company.street"><span t-esc="company.street"/></div>
                                <div t-if="company.street2"><span t-esc="company.street2"/></div>
                                <div>
                                    <span t-esc="company.zip or ''"/>
                                    <span t-esc="company.city or ''"/>
                                </div>
                                <div t-if="company.country_id">
                                    <span t-esc="company.country_id.name"/>
                                </div>
                                <br/>
                                <strong>Adresse :</strong><br/>
                                <span t-if="company.email" style="text-decoration: underline;" t-esc="company.email"/><br/>
                                <strong>Tel. :</strong> <span t-esc="o.company_id.phone or ''"/><br/>
                                <!-- fax field not available in this Odoo version -->
                            </div>
                        </div>

                        <div class="row mt-4 mb-4">
                            <div class="col-12 text-center" style="border: 2px solid black; padding: 10px;">
                                <h2 style="margin: 0; font-weight: bold;">BORDEREAU DE CONFIRMATION</h2>
                                <h3 style="margin: 0;">Virements SEPA</h3>
                            </div>
                        </div>

                        <div class="row" style="border: 1px solid black;">
                            <div class="col-8" style="border-right: 1px solid black; padding: 5px;">
                                Télétransmission par INTERNET, <br/>
                                Le <span t-out="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y à %H:%M')"/>
                            </div>
                            <div class="col-4 text-end" style="padding: 5px;">
                                <strong>N° de transmission :</strong><br/>
                                <br/>
                            </div>
                        </div>

                        <table class="table table-bordered mt-4" style="border: 1px solid black !important;">
                            <thead>
                                <tr class="text-center" style="font-size: 10px; background-color: #f2f2f2;">
                                    <th colspan="6">Résumé du fichier</th>
                                </tr>
                                <tr class="text-center" style="font-size: 10px;">
                                    <th style="width: 10%;">Remise</th>
                                    <th style="width: 40%;">IBAN</th>
                                    <th style="width: 20%;">Emetteur</th>
                                    <th style="width: 15%;">Date exécution</th>
                                    <th colspan="2" style="width: 15%;">Montant (EUR)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="text-center">
                                    <td>1</td>
                                    <td><span t-esc="o.journal_id.bank_account_id.acc_number or ''"/></td>
                                    <td><span t-esc="o.company_id.display_name"/></td>
                                    <td><span t-esc="o.date" t-options='{"widget": "date"}'/></td>
                                    <td style="border-right: none;"><span t-esc="len(o.payment_ids)"/></td>
                                    <td class="text-end">
                                        <span t-out="abs(o.amount)"
                                              t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                    </td>
                                </tr>
                                <tr style="font-weight: bold;">
                                    <td colspan="4" class="text-center">Montant total</td>
                                    <td style="border-right: none;"><span t-esc="len(o.payment_ids)"/></td>
                                    <td class="text-end">
                                        <span t-out="abs(o.amount)"
                                              t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="row mt-4" style="border-left: 1px solid black; border-top: 1px solid black; border-right: 1px solid black; border-bottom: 0px solid black;">
                            <div class="col-12 text-center" style="border-bottom: 0px solid black; padding: 5px;">
                                <strong>En cas d'anomalie de traitement, veuillez contacter :</strong>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6" style="padding: 10px; border-left: 1px solid black; border-top: 0px solid black; border-right: 0px solid black; border-bottom: 1px solid black;">
                                <strong>Société :</strong> <span t-out="o.company_id.name"/><br/>
                                <strong>Adresse :</strong> <span t-out="o.company_id.street"/><br/>
                                <span class="ms-5" t-out="o.company_id.zip"/> <span t-out="o.company_id.city"/>
                            </div>
                            <div class="col-6" style="padding: 10px; border-left: 0px solid black; border-top: 0px solid black; border-right: 1px solid black; border-bottom: 1px solid black;">
                                <strong>Interlocuteur :</strong><br/>
                                <div class="text-center">
                                    <br/>
                                    <strong>Tel. :</strong> <br/>
                                    <strong>Fax. :</strong>
                                </div>
                            </div>
                        </div>

                        <div class="row mt-4" style="page-break-inside: avoid;">
                            <div class="col-12" style="border: 1px solid black; padding: 0;">
                                <div class="text-center" style="background-color: #f2f2f2; border-bottom: 1px solid black; border-top: 1px solid black; border-right: 1px solid black; font-size: 10px;">ZONE RESERVÉE AU CLIENT</div>
                                <div class="row" style="min-height: 120px;">
                                    <div class="col-6" style="border-right: 1px solid black; padding: 5px;">
                                        Le : <br/><br/>
                                        Cachet :
                                    </div>
                                    <div class="col-6 p-1">Signature :</div>
                                </div>
                            </div>
                        </div>
                        <div class="row" style="page-break-inside: avoid;">
                            <div class="col-12 mt-4" style="border: 1px solid black; padding: 0;">
                                <div class="text-center" style="background-color: #f2f2f2; border-bottom: 1px solid black; border-top: 1px solid black; font-size: 10px;">ZONE RESERVÉE AU CFM INDOSUEZ WEALTH</div>
                                <div class="row" style="min-height: 100px;">
                                    <div class="col-6" style="border-right: 1px solid black; padding: 5px;">
                                        Nom du délégataire : <br/><br/>
                                        Fonction :
                                    </div>
                                    <div class="col-6 p-1">Signature :</div>
                                </div>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
