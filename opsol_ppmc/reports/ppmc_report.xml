<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_ppmc" model="report.paperformat">
        <field name="name">Papier Bordereau d'accompagnement</field>
        <field name="default" eval="True" />
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">43</field>
        <field name="margin_bottom">40</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">43</field>
        <field name="dpi">90</field>
        <field name="css_margins" eval="True" />
    </record>

    <record id="action_report_ppmc_payments" model="ir.actions.report">
        <field name="name">Bordereau d'accompagnement</field>
        <field name="model">account.batch.payment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">opsol_ppmc.report_ppmc_payment</field>
        <field name="report_file">opsol_ppmc.report_ppmc_payment</field>
        <field name="print_report_name">'Bordereau Accompagnement_%s' % (object.id)</field>
        <field name="paperformat_id" ref="opsol_ppmc.paperformat_ppmc"/>
        <field name="binding_model_id" ref="model_account_batch_payment"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
