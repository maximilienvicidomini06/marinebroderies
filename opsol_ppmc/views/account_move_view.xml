<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_form_order_virement" model="ir.ui.view">
        <field name="name">account.move.form.order.virement</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_print_order_virement"
                    type="object"
                    string="Ordre de virement"
                    class="btn-secondary"
                    invisible="not payment_ids"
                />
            </xpath>
        </field>
    </record>
</odoo>
