<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_opsol_ppmc_report_wizard_form" model="ir.ui.view">
        <field name="name">opsol.ppmc.report.wizard.form</field>
        <field name="model">opsol.ppmc.report.wizard</field>
        <field name="arch" type="xml">
            <form string="PPMC - Vendor Payments">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="company_id"/>
                        <field name="journal_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_report" type="object" string="Print" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_opsol_ppmc_report_wizard" model="ir.actions.act_window">
        <field name="name">PPMC - Vendor Payments</field>
        <field name="res_model">opsol.ppmc.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
