<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_server_print_ppmc_report" model="ir.actions.server">
        <field name="name">Print PPMC Report</field>
        <field name="model_id" ref="model_account_batch_payment"/>
        <field name="state">code</field>
        <field name="code">
action = env.ref("opsol_ppmc.action_report_ppmc_payments").report_action(records)
        </field>
    </record>

    <record id="action_server_open_first_batch" model="ir.actions.server">
        <field name="name">Open First Batch Payment</field>
        <field name="model_id" ref="model_account_batch_payment"/>
        <field name="state">code</field>
        <field name="code">
first_batch = records[:1]
action = {
    "type": "ir.actions.act_window",
    "name": "Batch Payment",
    "res_model": "account.batch.payment",
    "view_mode": "form",
    "res_id": first_batch.id,
    "target": "current",
}
        </field>
    </record>

    <record id="action_server_ppmc_report_and_open_batch" model="ir.actions.server">
        <field name="name">PPMC Report and Open Batch</field>
        <field name="model_id" ref="model_account_batch_payment"/>
        <field name="state">multi</field>
        <field name="child_ids" eval="[(4, ref('opsol_ppmc.action_server_print_ppmc_report')), (4, ref('opsol_ppmc.action_server_open_first_batch'))]"/>
    </record>
</odoo>
