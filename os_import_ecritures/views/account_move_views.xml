<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Clé d'import visible sur la pièce et filtrable -->
    <record id="view_move_form_import_key" model="ir.ui.view">
        <field name="name">account.move.form.os.import.key</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="os_import_key" invisible="not os_import_key" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_move_filter_import" model="ir.ui.view">
        <field name="name">account.move.search.os.import</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_move_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='unposted']" position="after">
                <separator/>
                <filter name="os_imported" string="Issues d'un import"
                        domain="[('os_import_key', '!=', False)]"/>
            </xpath>
        </field>
    </record>

</odoo>
