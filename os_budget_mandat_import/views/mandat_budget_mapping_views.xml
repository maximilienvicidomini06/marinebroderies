<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mandat_budget_mapping_list" model="ir.ui.view">
        <field name="name">mandat.budget.mapping.list</field>
        <field name="model">mandat.budget.mapping</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="code"/>
                <field name="name"/>
                <field name="general_account_id"/>
                <field name="analytic_account_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_mandat_budget_mapping_search" model="ir.ui.view">
        <field name="name">mandat.budget.mapping.search</field>
        <field name="model">mandat.budget.mapping</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <field name="analytic_account_id"/>
                <filter name="archived" string="Archivées" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_mandat_budget_mapping" model="ir.actions.act_window">
        <field name="name">Correspondances budgétaires</field>
        <field name="res_model">mandat.budget.mapping</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Associez chaque imputation (code du plan comptable) à un compte analytique</p>
            <p>Ex. 691332 → « Entretien, aménag. fourn. prest. ». Les correspondances choisies lors d'un import peuvent aussi être mémorisées automatiquement.</p>
        </field>
    </record>
</odoo>
