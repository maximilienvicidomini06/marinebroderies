<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_analytic_line_mandat_list" model="ir.ui.view">
        <field name="name">account.analytic.line.mandat.list</field>
        <field name="model">account.analytic.line</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="date"/>
                <field name="mandat_ref"/>
                <field name="general_account_id"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="analytic_distribution" widget="analytic_distribution" optional="hide"/>
                <field name="amount" sum="Total"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_analytic_line_mandat_search" model="ir.ui.view">
        <field name="name">account.analytic.line.mandat.search</field>
        <field name="model">account.analytic.line</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <search>
                <field name="mandat_ref"/>
                <field name="mandat_budget_code"/>
                <field name="partner_id"/>
                <field name="name"/>
                <field name="general_account_id"/>
                <filter name="group_code" string="Compte comptable" context="{'group_by': 'general_account_id'}"/>
                <filter name="group_partner" string="Fournisseur" context="{'group_by': 'partner_id'}"/>
                <filter name="group_month" string="Mois" context="{'group_by': 'date:month'}"/>
            </search>
        </field>
    </record>

    <record id="action_analytic_line_mandat" model="ir.actions.act_window">
        <field name="name">Mandats importés</field>
        <field name="res_model">account.analytic.line</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="view_id" ref="view_analytic_line_mandat_list"/>
        <field name="search_view_id" ref="view_analytic_line_mandat_search"/>
        <field name="domain">[('mandat_key', '!=', False)]</field>
        <field name="context">{'search_default_group_code': 1}</field>
    </record>
</odoo>
