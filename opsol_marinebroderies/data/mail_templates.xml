<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">
        <record id="mail_template_sale_order_client_validation" model="mail.template">
            <field name="name">Demande de confirmation client (Devis)</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">Merci de valider votre devis {{object.name}}</field>
            <field name="use_default_to">False</field>
            <field name="email_to">{{ object.partner_id.email or ''}}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<p>Merci de confirmer votre devis <strong t-esc="object.name"></strong>.</p>
<p>Veuillez cliquer sur le bouton <strong>Valider</strong> dans la page portail du devis :</p>
<p><a t-att-href="object.get_base_url() + object.get_portal_url()" target="_blank">Accéder au devis</a></p>
            </field>
        </record>

    </data>
</odoo>
