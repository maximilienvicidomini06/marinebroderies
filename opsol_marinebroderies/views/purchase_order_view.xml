<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="purchase_order_form_add_customer_delivery_date" model="ir.ui.view">
            <field name="name">purchase.order.form.add.customer.delivery.date</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='order_line']/list/field[@name='date_planned']" position="after">
                    <field name="x_customer_delivery_date" optional="show"/>
                    <field name="x_sale_partner_id" optional="show"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
