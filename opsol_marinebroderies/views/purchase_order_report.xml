<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="report_purchaseorder_document_customers"
              inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//div[@t-if='o.date_planned']" position="after">
            <div groups="sales_team.group_sale_salesman"
                 t-if="o.x_sale_partner_ids" class="col bm-2">
                <strong><t t-if="len(o.x_sale_partner_ids) > 1">Clients :</t><t t-else="">Client :</t></strong>
                <p t-out="', '.join(o.x_sale_partner_ids.mapped('display_name'))" class="m-0"/>
            </div>
        </xpath>
    </template>

    <record id="action_purchase_print_receipts_by_supplier" model="ir.actions.server">
        <field name="name">Produit par fournisseur</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_type">report</field>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_print_receipts_by_supplier()</field>
    </record>

    <record id="action_purchase_print_receipts_by_customer_available" model="ir.actions.server">
        <field name="name">Produit par Client</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_type">report</field>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_print_receipts_by_customer_available()</field>
    </record>

    <record id="action_report_purchase_by_supplier" model="ir.actions.report">
        <field name="name">Produit par fournisseur</field>
        <field name="model">purchase.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">opsol_marinebroderies.report_purchase_by_supplier</field>
        <field name="report_file">opsol_marinebroderies.report_purchase_by_supplier</field>
        <field name="print_report_name">'Achat - %s' % (object.name)</field>
    </record>
    <record id="action_report_purchase_by_customer_available" model="ir.actions.report">
        <field name="name">Produit par Client</field>
        <field name="model">purchase.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">opsol_marinebroderies.report_purchase_by_customer_available</field>
        <field name="report_file">opsol_marinebroderies.report_purchase_by_customer_available</field>
        <field name="print_report_name">'Achat - %s' % (object.name)</field>
    </record>

    <template id="report_purchase_by_supplier">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-set="supplier_groups" t-value="docs._get_purchase_report_groups()"/>
                <t t-foreach="supplier_groups" t-as="group">
                    <t t-set="group_orders" t-value="group['orders']"/>
                    <t t-set="group_partners" t-value="group_orders.mapped('partner_id')"/>
                    <div class="page" t-att-style="'page-break-after: always;' if not group_last else 'page-break-after: auto;'">
                        <div class="mb16">
                            <div t-if="len(group_orders) == 1">
                                <strong t-translate="opsol_marinebroderies.report_purchase_by_supplier.reference">Commande :</strong>
                                <span t-esc="group_orders.name"/>
                            </div>
                            <div t-else="">
                                <strong t-translate="opsol_marinebroderies.report_purchase_by_supplier.pickings">Commandes :</strong>
                                <span t-esc="', '.join(group_orders.mapped('name'))"/>
                            </div>
                            <div t-if="group_partners">
                                <strong t-translate="opsol_marinebroderies.report_purchase_by_supplier.partner">Partenaire:</strong>
                                <span t-esc="', '.join(group_partners.mapped('display_name'))"/>
                            </div>
                            <div t-if="len(group_orders) == 1 and group_orders.date_planned">
                                <strong t-translate="opsol_marinebroderies.report_purchase_by_supplier.date_planned">Date prevue:</strong>
                                <span t-esc="group_orders.date_planned"/>
                            </div>
                        </div>

                        <h3>
                            <span t-translate="opsol_marinebroderies.report_purchase_by_supplier.supplier">Fournisseur:</span>
                            <t t-if="group['partner']">
                                <span t-esc="group['partner'].display_name"/>
                            </t>
                            <t t-else="">
                                <span t-translate="opsol_marinebroderies.report_purchase_by_supplier.unavailable">Non disponible</span>
                            </t>
                        </h3>
                        <style>
                            .purchase_supplier_report_table {
                                border-collapse: collapse !important;
                                page-break-inside: auto;
                            }
                            .purchase_supplier_report_table thead {
                                display: table-header-group;
                            }
                            .purchase_supplier_report_table tbody {
                                display: table-row-group;
                            }
                            .purchase_supplier_report_table tr {
                                page-break-inside: avoid;
                                break-inside: avoid;
                                page-break-after: auto;
                            }
                            .purchase_supplier_report_table th,
                            .purchase_supplier_report_table td {
                                border: 1px solid #adb5bd !important;
                            }
                            .purchase_supplier_report_table tbody tr:nth-child(odd) td {
                                background-color: #f2f2f2 !important;
                            }
                            .purchase_supplier_report_table tbody tr:nth-child(even) td {
                                background-color: #ffffff !important;
                            }
                            .purchase_supplier_report_table td.supplier-color-column {
                                background-color: #e9ecef !important;
                                font-weight: 700;
                            }
                            .purchase_supplier_report_table td.supplier-size-column {
                                background-color: #f8f9fa !important;
                                font-weight: 700;
                            }
                            .purchase_supplier_report_table tbody tr.supplier-client-group td[colspan="5"] {
                                background-color: #f8f9fa !important;
                                font-weight: 700;
                            }
                            .purchase_supplier_report_table tbody tr.supplier-color-group td {
                                border-top: 2px solid #343a40 !important;
                            }
                            .purchase_supplier_report_table tbody tr.supplier-size-group td {
                                border-top: 1px solid #6c757d !important;
                            }
                        </style>
                        <table class="table table-sm o_main_table purchase_supplier_report_table">
                            <thead>
                                <tr>
                                    <th>Couleur</th>
                                    <th>Taille</th>
                                    <th>N°</th>
                                    <th t-translate="opsol_marinebroderies.report_purchase_by_supplier.product">Produit</th>
                                    <th t-translate="opsol_marinebroderies.report_purchase_by_supplier.description">Description</th>
                                    <th class="" t-translate="opsol_marinebroderies.report_purchase_by_supplier.quantity">Quantite</th>
                                    <th t-translate="opsol_marinebroderies.report_purchase_by_supplier.uom">UdM</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="group['variant_groups']" t-as="color_group">
                                    <t t-foreach="color_group['tailles']" t-as="size_group">
                                        <t t-foreach="size_group['lines']" t-as="client_group">
                                            <t t-foreach="client_group['articles']" t-as="line">
                                                <tr t-att-class="'supplier-client-group'" t-if="line_first">
                                                    <td t-if="size_group_first and client_group_first" t-att-rowspan="color_group['color_span'] + 1" t-esc="color_group['color']" />
                                                    <td t-if="client_group_first" t-att-rowspan="size_group['size_span'] + 1" t-esc="size_group['taille']" />
                                                    <td colspan="5">
                                                        Client : <span t-esc="client_group['client'].display_name or 'Non disponible'"/>
                                                    </td>
                                                </tr>
                                                <tr style="page-break-inside: avoid; break-inside: avoid;">
                                                    <td t-esc="line.get('report_index', line_index + 1)"/>
                                                    <td>
                                                        <span t-esc="line['product'].display_name"/>
                                                    </td>
                                                    <td>
                                                        <span t-if="line['description'] != line['product'].display_name" t-esc="line['description']"/>
                                                    </td>
                                                    <td class="text-end">
                                                        <span t-esc="('%.0f' % line['qty']) if line['qty'] % 1 == 0 else ('%.2f' % line['qty'])"/>
                                                    </td>
                                                    <td t-esc="line['uom'].name"/>
                                                </tr>
                                            </t>
                                        </t>
                                    </t>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_purchase_by_customer_available">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-set="customer_groups" t-value="docs._get_purchase_report_groups(by_customer=True)"/>
                <t t-foreach="customer_groups" t-as="group">
                    <t t-set="group_orders" t-value="group['orders']"/>
                    <t t-set="single_order" t-value="group_orders[0] if len(group_orders) == 1 else False"/>
                    <div class="page" t-att-style="'page-break-after: always;' if not group_last else 'page-break-after: auto;'">
                        <h2>
                            <span>Produits par client</span>
                        </h2>
                        <div class="mb16">
                            <div t-if="single_order">
                                <strong>Commande :</strong>
                                <span t-esc="single_order.name"/>
                            </div>
                            <div t-else="">
                                <strong>Commandes :</strong>
                                <span t-esc="', '.join(group_orders.mapped('name'))"/>
                            </div>
                            <div t-if="single_order and single_order.partner_id">
                                <strong>Partenaire:</strong>
                                <span t-esc="single_order.partner_id.display_name"/>
                            </div>
                            <div t-if="single_order and single_order.date_planned">
                                <strong>Date prevue:</strong>
                                <span t-esc="single_order.date_planned"/>
                            </div>
                        </div>

                        <h3>
                            <span>Client:</span>
                            <t t-if="group['partner']">
                                <span t-esc="group['partner'].display_name"/>
                            </t>
                            <t t-else="">
                                <span>Non disponible</span>
                            </t>
                        </h3>
                        <table class="table table-sm o_main_table">
                            <thead>
                                <tr>
                                    <th>N°</th>
                                    <th>Produit</th>
                                    <th>Description</th>
                                    <th class="">Quantite commandee</th>
                                    <th>UdM</th>
                                    <th>Observation</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="previous_supplier" t-value="False"/>
                                <t t-foreach="group['lines']" t-as="line">
                                    <t t-set="supplier" t-value="line['supplier']"/>
                                    <tr t-if="line_first or supplier != previous_supplier" class="table-light">
                                        <td colspan="6">
                                            <strong>Fournisseur : <span t-esc="supplier.display_name or 'Non disponible'"/></strong>
                                        </td>
                                    </tr>
                                    <t t-set="is_waiting" t-value="any(pol.qty_received &lt; pol.product_qty for pol in line['purchase_lines'])"/>
                                    <tr>
                                        <td t-esc="line_index + 1"/>
                                        <td t-esc="line['product'].display_name"/>
                                        <td>
                                            <span t-if="line['description'] != line['product'].display_name" t-esc="line['description']"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-esc="('%.0f' % line['qty']) if line['qty'] % 1 == 0 else ('%.2f' % line['qty'])"/>
                                        </td>
                                        <td t-esc="line['uom'].name"/>
                                        <td>
                                            <span t-if="is_waiting">En attente de reception</span>
                                        </td>
                                    </tr>
                                    <t t-set="previous_supplier" t-value="supplier"/>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
