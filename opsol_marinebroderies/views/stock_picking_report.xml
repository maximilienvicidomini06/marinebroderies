<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="action_report_stock_picking_by_supplier" model="ir.actions.report">
            <field name="name">Produit par fournisseur</field>
            <field name="model">stock.picking</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">opsol_marinebroderies.report_stock_picking_by_supplier</field>
            <field name="report_file">opsol_marinebroderies.report_stock_picking_by_supplier</field>
            <field name="print_report_name">'Picking - %s' % (object.name)</field>
        </record>

        <record id="action_report_stock_picking_by_supplier_available" model="ir.actions.report">
            <field name="name">Produit par Client (Disponible)</field>
            <field name="model">stock.picking</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">opsol_marinebroderies.report_stock_picking_by_supplier_available</field>
            <field name="report_file">opsol_marinebroderies.report_stock_picking_by_supplier_available</field>
            <field name="print_report_name">'Picking - %s' % (object.name)</field>
        </record>

        <template id="report_stock_picking_by_supplier">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <t t-set="supplier_groups" t-value="docs._get_supplier_groups_multi()"/>
                    <t t-foreach="supplier_groups" t-as="group">
                        <t t-set="group_pickings" t-value="group['moves'].mapped('picking_id')"/>
                        <t t-set="group_partners" t-value="group_pickings.mapped('partner_id')"/>
                        <div class="page" t-att-style="'page-break-after: always;' if not group_last else 'page-break-after: auto;'">
                            <!-- <h2>
                                <span t-translate="opsol_marinebroderies.report_stock_picking_by_supplier.title">Produits par fournisseur</span>
                            </h2> -->
                            <div class="mb16">
                                <div t-if="len(group_pickings) == 1">
                                    <strong t-translate="opsol_marinebroderies.report_stock_picking_by_supplier.reference">Picking:</strong>
                                    <span t-esc="group_pickings.name"/>
                                </div>
                                <div t-else="">
                                    <strong t-translate="opsol_marinebroderies.report_stock_picking_by_supplier.pickings">Pickings:</strong>
                                    <span t-esc="', '.join(group_pickings.mapped('name'))"/>
                                </div>
                                <div t-if="group_partners">
                                    <strong t-translate="opsol_marinebroderies.report_stock_picking_by_supplier.partner">Partenaire:</strong>
                                    <span t-esc="', '.join(group_partners.mapped('display_name'))"/>
                                </div>
                                <div t-if="len(group_pickings) == 1 and group_pickings.scheduled_date">
                                    <strong t-translate="opsol_marinebroderies.report_stock_picking_by_supplier.scheduled_date">Date prevue:</strong>
                                    <span t-esc="group_pickings.scheduled_date"/>
                                </div>
                            </div>

                            <h3>
                                <span t-translate="opsol_marinebroderies.report_stock_picking_by_supplier.supplier">Fournisseur:</span>
                                <t t-if="group['partner']">
                                    <span t-esc="group['partner'].display_name"/>
                                </t>
                                <t t-else="">
                                    <span t-translate="opsol_marinebroderies.report_stock_picking_by_supplier.unavailable">Non disponible</span>
                                </t>
                            </h3>
                            <table class="table table-sm o_main_table">
                                <thead>
                                    <tr>
                                        <th t-translate="opsol_marinebroderies.report_stock_picking_by_supplier.product">Produit</th>
                                        <th t-translate="opsol_marinebroderies.report_stock_picking_by_supplier.description">Description</th>
                                        <th class="" t-translate="opsol_marinebroderies.report_stock_picking_by_supplier.quantity">Quantite</th>
                                        <th t-translate="opsol_marinebroderies.report_stock_picking_by_supplier.uom">UdM</th>
                                        <th t-translate="opsol_marinebroderies.report_stock_picking_by_supplier.customer">Client</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="group['lines']" t-as="line">
                                        <td t-esc="line['product'].display_name"/>
                                        <td>
                                            <span t-if="line['description'] != line['product'].display_name" t-esc="line['description']"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-esc="('%.0f' % line['qty']) if line['qty'] % 1 == 0 else ('%.2f' % line['qty'])" />
                                        </td>
                                        <td t-esc="line['uom'].name"/>
                                        <td>
                                            <span t-if="line['_customer_ids']" t-esc="', '.join([customer.display_name for customer in line['_customer_ids']])"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </t>
                </t>
            </t>
        </template>

        <template id="report_stock_picking_by_supplier_available">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <t t-set="single_picking" t-value="docs[0] if len(docs) == 1 else False"/>
                    <t t-set="customer_groups" t-value="docs._get_customer_groups_multi_available(show_not_available=False)"/>
                    <div class="page">
                        <h2>
                            <span>Produits par client (Disponible)</span>
                        </h2>
                        <div class="mb16">
                            <div t-if="single_picking">
                                <strong>Reference:</strong>
                                <span t-esc="single_picking.name"/>
                            </div>
                            <div t-else="">
                                <strong>Pickings:</strong>
                                <span t-esc="', '.join(docs.mapped('name'))"/>
                            </div>
                            <div t-if="single_picking and single_picking.partner_id">
                                <strong>Partenaire:</strong>
                                <span t-esc="single_picking.partner_id.display_name"/>
                            </div>
                            <div t-if="single_picking and single_picking.scheduled_date">
                                <strong>Date prevue:</strong>
                                <span t-esc="single_picking.scheduled_date"/>
                            </div>
                        </div>

                        <t t-foreach="customer_groups" t-as="group">
                            <h3>
                                <span>Client:</span>
                                <t t-if="group['partner']">
                                    <span t-esc="group['partner'].display_name"/>
                                </t>
                                <t t-else="">
                                    <span>Non disponible</span>
                                </t>
                            </h3>
                            <table class="table table-sm o_main_table">
                                <thead>
                                    <tr>
                                        <th>Produit</th>
                                        <th>Description</th>
                                        <th class="">Quantite disponible</th>
                                        <th>UdM</th>
                                        <th>Observation</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="group['lines']" t-as="line">
                                        <t t-set="is_waiting" t-value="'waiting' in line['moves'].mapped('state')" />
                                        <tr t-if="line['available_qty'] != 0">
                                            <td t-esc="line['product'].display_name"/>
                                            <td>
                                                <span t-if="line['description'] != line['product'].display_name" t-esc="line['description']"/>
                                            </td>
                                            <td class="text-end">
                                                <span t-esc="('%.0f' % line['available_qty']) if line['available_qty'] % 1 == 0 else ('%.2f' % line['available_qty'])" />
                                            </td>
                                            <td t-esc="line['uom'].name"/>
                                            <td>
                                                <span t-if="is_waiting">En attente de reception</span>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                    </div>
                </t>
            </t>
        </template>

        <record id="action_report_delivery_slip_sale_style" model="ir.actions.report">
            <field name="name">Bon de livraison (avec sections)</field>
            <field name="model">stock.picking</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">opsol_marinebroderies.report_delivery_slip_sale_style</field>
            <field name="report_file">opsol_marinebroderies.report_delivery_slip_sale_style</field>
            <field name="print_report_name">'Bon de livraison - %s' % (object.name)</field>
            <field name="binding_model_id" ref="stock.model_stock_picking"/>
            <field name="binding_type">report</field>
        </record>

        <template id="report_delivery_slip_sale_style">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-set="o" t-value="o.with_context(lang=o._get_report_lang())"/>
                    <t t-set="partner" t-value="o.partner_id or (o.move_ids and o.move_ids[0].partner_id) or False"/>
                    <t t-call="web.external_layout">
                        <t t-set="address">
                            <div t-if="partner" t-out="partner"
                                 t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'/>
                        </t>
                        <t t-set="information_block">
                            <div class="row">
                                <div class="col-7" t-if="partner and partner != partner.commercial_partner_id">
                                    <strong>Adresse du client</strong>
                                    <div t-field="partner.commercial_partner_id"
                                         t-options='{"widget": "contact", "fields": ["address", "name", "phone", "vat"], "no_marker": True, "phone_icons": True}'/>
                                </div>
                            </div>
                        </t>

                        <div class="page">
                            <div class="oe_structure"/>
                            <t t-set="sale_order" t-value="o.sale_id or o.move_ids.mapped('sale_line_id.order_id')[:1]"/>
                            <h2>
                                <span>Bon de livraison #</span>
                                <span t-field="o.name"/>
                            </h2>

                            <div class="row mb-4" id="informations">
                                <div t-if="o.origin" class="col" name="informations_origin">
                                    <strong>Commande</strong>
                                    <div t-field="o.origin"/>
                                </div>
                                <div t-if="o.state" class="col" name="informations_date">
                                    <strong>Date de livraison</strong>
                                    <div t-if="o.state == 'done'" t-field="o.date_done" t-options="{'widget': 'date'}"/>
                                    <div t-else="" t-field="o.scheduled_date" t-options="{'widget': 'date'}"/>
                                </div>
                                <div t-if="sale_order and sale_order.client_order_ref" class="col" name="informations_reference">
                                    <strong>Référence client</strong>
                                    <div t-field="sale_order.client_order_ref"/>
                                </div>
                                <div t-if="o.user_id" class="col" name="informations_operator">
                                    <strong>Responsable</strong>
                                    <div t-field="o.user_id"/>
                                </div>
                            </div>

                            <t t-set="format_number" t-value="lambda value: int(value) if value == int(value) else value"/>
                            <table class="o_has_total_table table o_main_table table-borderless">
                                <thead style="display: table-row-group">
                                    <tr>
                                        <th name="th_description" class="text-start">Description</th>
                                        <th name="th_ordered" class="text-end text-nowrap">Commandé</th>
                                        <th name="th_delivered" class="text-end text-nowrap">Livré</th>
                                    </tr>
                                </thead>
                                <tbody class="sale_tbody">
                                    <t t-set="current_section" t-value="None"/>
                                    <t t-set="current_subsection" t-value="None"/>
                                    <t t-foreach="o._get_delivery_report_lines()" t-as="report_line">
                                        <t t-set="line" t-value="report_line['line']"/>
                                        <t t-set="is_section" t-value="report_line['type'] == 'line_section'"/>
                                        <t t-set="is_subsection" t-value="report_line['type'] == 'line_subsection'"/>
                                        <t t-set="is_note" t-value="report_line['type'] == 'line_note'"/>
                                        <t t-if="is_section">
                                            <t t-set="current_section" t-value="line"/>
                                            <t t-set="current_subsection" t-value="None"/>
                                            <t t-set="line_padding" t-value="0"/>
                                        </t>
                                        <t t-elif="is_subsection">
                                            <t t-set="current_subsection" t-value="line"/>
                                            <t t-set="line_padding" t-value="2"/>
                                        </t>
                                        <t t-else="">
                                            <t t-set="line_padding" t-value="3 if current_subsection else (2 if current_section else 0)"/>
                                        </t>
                                        <t t-set="padding_class" t-value="line_padding and ('px-' + str(line_padding)) or ''"/>

                                        <tr t-if="is_section or is_subsection" name="tr_section"
                                            t-att-class="'fw-bolder o_line_section' if is_section else 'fw-bold o_line_subsection'">
                                            <td colspan="3" t-att-class="padding_class">
                                                <span t-field="line.name"/>
                                            </td>
                                        </tr>
                                        <tr t-elif="is_note" name="tr_note" class="fst-italic o_line_note">
                                            <td colspan="3" t-att-class="padding_class">
                                                <span t-field="line.name"/>
                                            </td>
                                        </tr>
                                        <tr t-else="" name="tr_product">
                                            <t t-set="moves" t-value="report_line['moves']"/>
                                            <td t-att-class="padding_class">
                                                <t t-if="line">
                                                    <span t-field="line.name"/>
                                                </t>
                                                <t t-else="">
                                                    <span t-field="moves.product_id"/>
                                                    <p t-if="moves.description_picking">
                                                        <span t-out="moves.description_picking" t-options="{'widget': 'text'}"/>
                                                    </p>
                                                </t>
                                            </td>
                                            <td class="o_td_quantity text-end">
                                                <span t-out="format_number(line.product_uom_qty if line else moves.product_uom_qty)"/>
                                                <span t-field="line.product_uom" t-if="line"/>
                                                <span t-field="moves.product_uom" t-else=""/>
                                            </td>
                                            <td class="o_td_quantity text-end">
                                                <span t-out="format_number(sum(moves.mapped('quantity')))"/>
                                                <span t-field="line.product_uom" t-if="line"/>
                                                <span t-field="moves.product_uom" t-else=""/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                            <div class="oe_structure"/>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>
