<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_order_form_opsol" model="ir.ui.view">
            <field name="name">sale.order.form.opsol</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">

                <!-- Move commitment_date and place it after date_order -->
                <xpath expr="//field[@name='commitment_date']" position="replace"></xpath>
                <xpath expr="//field[@name='payment_term_id']" position="before">
                    <field name="commitment_date" />
                </xpath>

            </field>
        </record>
    </data>
</odoo>
