<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_type_broderie_tree" model="ir.ui.view">
        <field name="name">opsol.marinebroderies.type.broderie.tree</field>
        <field name="model">opsol_marinebroderies.type_broderie</field>
        <field name="arch" type="xml">
            <list string="Types de broderie" default_order="name">
                <field name="name"/>
                <field name="related_product_id"/>
            </list>
        </field>
    </record>

    <record id="view_type_broderie_form" model="ir.ui.view">
        <field name="name">opsol.marinebroderies.type.broderie.form</field>
        <field name="model">opsol_marinebroderies.type_broderie</field>
        <field name="arch" type="xml">
            <form string="Type de broderie">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="related_product_id" options="{'no_create': False}"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_type_broderie" model="ir.actions.act_window">
        <field name="name">Types de broderie</field>
        <field name="res_model">opsol_marinebroderies.type_broderie</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre premier type de broderie
            </p>
        </field>
    </record>

    <menuitem id="menu_type_broderie"
              name="Types de broderie"
              parent="sale.menu_sale_config"
              action="action_type_broderie"/>
</odoo>
