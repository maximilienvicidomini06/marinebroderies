<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="sale_order_portal_template_inherit_client_validate" inherit_id="sale.sale_order_portal_template">
        <xpath expr="//div[@id='sale_order_sidebar_button']/a[1]" position="before">
            <form
                t-if="not sale_order.client_validation_date"
                method="POST"
                t-attf-action="/my/orders/#{sale_order.id}/client_validate?access_token=#{sale_order.access_token}"
            >
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <button type="submit" class="btn btn-secondary w-100">
                    <i class="fa fa-check"/>
                    <span>Valider</span>
                </button>
            </form>
        </xpath>

        <xpath expr="//div[@name='sale_order_actions']/t[@t-if='sale_order._has_to_be_signed()']/div[1]" position="before">
            <div class="col-sm-auto mt8" t-if="not sale_order.client_validation_date">
                <form
                    method="POST"
                    t-attf-action="/my/orders/#{sale_order.id}/client_validate?access_token=#{sale_order.access_token}"
                >
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <button type="submit" class="btn btn-secondary">
                        <i class="fa fa-check"/>
                        <span>Valider</span>
                    </button>
                </form>
            </div>
        </xpath>
    </template>
</odoo>
