<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="analytic_amount_wizard_form" model="ir.ui.view">
        <field name="name">analytic.amount.wizard.form</field>
        <field name="model">analytic.amount.wizard</field>
        <field name="arch" type="xml">
            <form string="Répartition analytique en montant">
                <group>
                    <field name="move_line_id"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="total_amount"/>
                </group>
                <field name="line_ids">
                    <list editable="bottom">
                        <field name="currency_id" column_invisible="True"/>
                        <field name="analytic_account_id"/>
                        <field name="plan_id"/>
                        <field name="amount" sum="Total réparti"/>
                        <field name="percentage"/>
                    </list>
                </field>
                <footer>
                    <button name="action_apply" type="object" string="Appliquer" class="btn-primary"/>
                    <button string="Annuler" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
