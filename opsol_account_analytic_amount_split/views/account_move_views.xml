<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_analytic_amount" model="ir.ui.view">
        <field name="name">account.move.form.analytic.amount</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']/list/field[@name='analytic_distribution']" position="after">
                <button name="action_open_analytic_amount_wizard"
                        type="object"
                        icon="fa-calculator"
                        title="Répartir en montant"
                        groups="analytic.group_analytic_accounting"/>
            </xpath>
        </field>
    </record>
</odoo>
