<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--
        Override de la vue liste sign.request (All Documents)
        pour activer le panneau d'aperçu PDF inline.
    -->
    <record id="sign_request_list_preview_view" model="ir.ui.view">
        <field name="name">sign.request.list.preview</field>
        <field name="model">sign.request</field>
        <field name="type">list</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list js_class="sign_request_list_preview"
                  decoration-success="state == 'signed'"
                  decoration-info="state == 'sent'"
                  decoration-muted="state == 'canceled'">
                <field name="name" string="Nom"/>
                <field name="template_id" string="Modèle" optional="show"/>
                <field name="request_item_ids" string="Signataires" widget="many2many_tags" optional="show"/>
                <field name="state" string="Statut" widget="badge"
                       decoration-success="state == 'signed'"
                       decoration-info="state == 'sent'"
                       decoration-warning="state == 'canceled'"/>
                <field name="create_date" string="Date" optional="show"/>
            </list>
        </field>
    </record>
</odoo>
