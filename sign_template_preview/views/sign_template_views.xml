<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--
        Override de la vue liste sign.template pour brancher
        le js_class "sign_template_list_preview" qui active
        le panneau d'aperçu PDF inline.

        La priorité 99 garantit que cette vue prend le dessus
        sur la vue liste native du module sign.
    -->
    <record id="sign_template_list_preview_view" model="ir.ui.view">
        <field name="name">sign.template.list.preview</field>
        <field name="model">sign.template</field>
        <field name="type">list</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list js_class="sign_template_list_preview"
                  decoration-muted="active == False">
                <field name="display_name" string="Nom du modèle"/>
                <field name="tag_ids" widget="many2many_tags" optional="show"/>
                <field name="active" invisible="1"/>
            </list>
        </field>
    </record>
</odoo>
