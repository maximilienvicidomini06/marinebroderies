<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="opsol_produit_financier.BankRecStatementLine"
       t-inherit="account_accountant.BankRecStatementLine"
       t-inherit-mode="extension">
        <xpath expr="//span[@name='statement_line_partner_name']" position="after">
            <span t-if="recordData.financial_partner_is_product" class="text-muted ms-1">
                Quantite: <t t-esc="recordData.financial_quantity"/>
            </span>
        </xpath>
    </t>
</templates>
