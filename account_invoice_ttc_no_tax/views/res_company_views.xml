<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_company_form_account_invoice_ttc_no_tax" model="ir.ui.view">
        <field name="name">res.company.form.account.invoice.ttc.no.tax</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="enable_ttc_no_tax_conversion"/>
            </xpath>
        </field>
    </record>
</odoo>
